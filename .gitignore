# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
# staging (también cubierto por .env*.local; explícito por seguridad)
.env.staging.local
.env.staging
.env.*.staging*
.env.e2e.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tmp/e2e-results.json

# local database backups (never commit)
/backups/

# Supabase CLI local cache (never commit; do not link to production)
/supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android kiosk (Gradle builds; source under android-kiosk/ is tracked)
android-kiosk/.gradle/
android-kiosk/**/build/
android-kiosk/local.properties
android-kiosk/*.apk
android-kiosk/*.aab
android-kiosk/.idea/
android-kiosk/captures/
/.next-perf-prod/
public/_review_clients_qr/

# Evidencias locales de validación (no publicar)
evidence/

# Entrega muestras PDF headless (muy pesados; previews PNG sí se versionan)
docs/qa/share/ENTREGA_MUESTRAS_MATERIAL_2026-11-27/*.pdf
# Fondos master HD (se usan *-print.jpg en runtime)
public/images/posters/flyer-acceso-qr-a6.png
public/images/posters/cartel-publicitario-a3.png
public/images/posters/cartel-acceso-qr-a5.png
# APK binarios
docs/qa/share/ENTREGA_APK_TEST/*.apk
android-kiosk/app/build/
