<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- USB host: solo enumeración/permisos en etapa 1; no escritura a endpoints. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FarmaFacilKiosk"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorPortrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".diagnostics.UsbDiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:screenOrientation="sensorPortrait" />

        <activity
            android:name=".diagnostics.PrinterTestActivity"
            android:exported="false"
            android:label="@string/printer_test_title"
            android:screenOrientation="sensorPortrait" />

        <!-- Solo útil en flavor staging (ENABLE_PERF_PROBE); se autoblinda en onCreate. -->
        <activity
            android:name=".diagnostics.StagingPerfDiagnosticsActivity"
            android:exported="false"
            android:label="@string/staging_perf_title"
            android:screenOrientation="sensorPortrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Device Admin / Lock Task: declarado para pruebas futuras.
          NO aprovisiona Device Owner al instalar. Ver docs/LOCK_TASK_SAFE_TEST.md
        -->
        <receiver
            android:name=".locktask.KioskDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Impresión ICOD vía USBAPI (VID 0483 / PID 7540).
          Sin intent-filter USB automático: el permiso se pide en diagnóstico
          o al imprimir (UsbPermissionHelper), para no capturar el bus al arrancar.
        -->
    </application>
</manifest>
