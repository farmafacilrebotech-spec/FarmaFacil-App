<?xml version="1.0" encoding="utf-8"?>
<!-- Logo circular turquesa + banda naranja STAGING (adaptive foreground). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2EC4C7" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="72dp">
        <shape android:shape="rectangle">
            <solid android:color="#E67E22" />
        </shape>
    </item>
</layer-list>
